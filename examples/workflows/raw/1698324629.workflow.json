  "actions": [
    {
      "actionId": "1",
      "secretNames": [
        "Workflow_Custom_Code_Actions"
      ],
      "sourceCode": "def main(event):\n    \"\"\"\n    Build webinar_new by splitting webinar_attended on semicolons and appending campaignTag,\n    but only if it is not already present in the list.\n    \"\"\"\n\n    error = {\n        \"state\": 0,\n        \"message\": \"\"\n    }\n\n    input_fields = event.get(\"inputFields\", {}) or {}\n\n    # Preserve the original value exactly as received\n    original_wa = input_fields.get(\"webinar_attended\") or \"\"\n\n    # Split into list called 'tags', trimming whitespace and skipping empties\n    tags = []\n    if isinstance(original_wa, str) and original_wa:\n        tags = [t.strip() for t in original_wa.split(\";\") if t.strip()]\n\n    # Get campaign tag and append to the end of tags if present and not already there\n    campaign_tag = input_fields.get(\"campaignTag\")\n    if campaign_tag is not None:\n        ct = str(campaign_tag).strip()\n        if ct and ct not in tags:  # exact match check; make case-insensitive by comparing ct.lower() not in [t.lower() for t in tags]\n            tags.append(ct)\n\n    # Turn tags back into a semicolon-separated string\n    webinar_new = \";\".join(tags)\n\n    return {\n        \"outputFields\": {\n            \"web_attend_original\": original_wa,\n            \"campaign_tag\": campaign_tag,\n            \"newValue\": webinar_new,\n            \"error_state\": error.get(\"state\"),\n            \"error\": error.get(\"message\")\n        }\n    }\n",
      "runtime": "PYTHON39",
