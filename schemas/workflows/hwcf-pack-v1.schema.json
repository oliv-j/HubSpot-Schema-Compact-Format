{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/workflows/hwcf-pack-v1.schema.json",
  "title": "HWCF workflow pack v1",
  "type": "object",
  "required": ["v", "kind", "profile", "m", "sk", "idx", "refs", "raw"],
  "properties": {
    "v": {"const": "hwcf-1"},
    "kind": {"const": "hubspot_workflow_pack"},
    "profile": {"enum": ["full", "view"]},
    "m": {
      "type": "object",
      "required": ["id", "name", "type", "flowType", "enabled", "stepCount", "goalCount", "excludedActionCount"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "type": {"type": ["string", "null"]},
        "flowType": {"type": ["string", "null"]},
        "enabled": {"type": ["boolean", "null"]},
        "desc": {"type": ["string", "null"]},
        "createdAt": {"type": ["string", "null"]},
        "updatedAt": {"type": ["string", "null"]},
        "revisionId": {"type": ["string", "null"]},
        "uuid": {"type": ["string", "null"]},
        "objectTypeId": {"type": ["string", "null"]},
        "startActionId": {"type": ["string", "null"]},
        "nextAvailableActionId": {"type": ["string", "null"]},
        "crmObjectCreationStatus": {"type": ["string", "null"]},
        "canEnrollFromSalesforce": {"type": ["boolean", "null"]},
        "stepCount": {"type": "integer", "minimum": 0},
        "goalCount": {"type": "integer", "minimum": 0},
        "excludedActionCount": {"type": "integer", "minimum": 0},
        "hasEnrollmentCriteria": {"type": "boolean"},
        "hasUnenrollmentCriteria": {"type": "boolean"},
        "suppressionListCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "d": {
      "type": "object",
      "properties": {
        "t": {
          "type": "array",
          "items": {"type": ["string", "null"]}
        }
      },
      "required": ["t"],
      "additionalProperties": false
    },
    "sk": {
      "type": "array",
      "items": {"type": "string"}
    },
    "s": {
      "type": "array",
      "items": {"type": "array"}
    },
    "idx": {
      "type": "object",
      "required": ["step", "type"],
      "properties": {
        "step": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "type": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "object",
      "required": ["full", "steps"],
      "properties": {
        "full": {"type": "string"},
        "steps": {"type": "string"}
      },
      "additionalProperties": false
    },
    "x": {"type": "object"},
    "wk": {
      "type": "array",
      "items": {"type": "string"}
    },
    "w": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": ["string", "number", "boolean", "null", "object", "array"]}
      }
    },
    "raw": {
      "type": "object",
      "required": ["sourceHash"],
      "properties": {
        "sourceHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "encodedAt": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "full"}}},
      "then": {
        "required": ["d", "s", "x", "wk", "w"]
      }
    },
    {
      "if": {"properties": {"profile": {"const": "view"}}},
      "then": {
        "not": {"required": ["s"]}
      }
    }
  ],
  "additionalProperties": false
}
